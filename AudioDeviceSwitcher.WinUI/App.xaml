<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AudioDeviceSwitcher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Windows App SDK Fluent 2 control styles & type ramp -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- ================= LIGHT THEME ================= -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="LayerFillColorDefault">#0A000000</Color>
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource LayerFillColorDefault}" />

                    <Color x:Key="LayerOnMicaBaseAltFillColorDefault">#12000000</Color>
                    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="{StaticResource LayerOnMicaBaseAltFillColorDefault}" />

                    <Color x:Key="SolidBackgroundFillColorBase">#F3F3F3</Color>
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource SolidBackgroundFillColorBase}" />

                    <Color x:Key="TextFillColorPrimary">#E4000000</Color>
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextFillColorPrimary}" />

                    <Color x:Key="TextFillColorSecondary">#9E000000</Color>
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextFillColorSecondary}" />

                    <Color x:Key="CardStrokeColorDefault">#0F000000</Color>
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource CardStrokeColorDefault}" />

                    <Color x:Key="AcrylicFlyoutFillColor">#D9F9F9F9</Color>
                    <SolidColorBrush x:Key="AcrylicFlyoutFillColorBrush" Color="{StaticResource AcrylicFlyoutFillColor}" />
                </ResourceDictionary>

                <!-- ================= DARK THEME ================== -->
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="LayerFillColorDefault">#12FFFFFF</Color>
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource LayerFillColorDefault}" />

                    <Color x:Key="LayerOnMicaBaseAltFillColorDefault">#1AFFFFFF</Color>
                    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="{StaticResource LayerOnMicaBaseAltFillColorDefault}" />

                    <Color x:Key="SolidBackgroundFillColorBase">#202020</Color>
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource SolidBackgroundFillColorBase}" />

                    <Color x:Key="TextFillColorPrimary">#FFFFFFFF</Color>
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextFillColorPrimary}" />

                    <Color x:Key="TextFillColorSecondary">#C5FFFFFF</Color>
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextFillColorSecondary}" />

                    <Color x:Key="CardStrokeColorDefault">#17FFFFFF</Color>
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource CardStrokeColorDefault}" />

                    <Color x:Key="AcrylicFlyoutFillColor">#D9242424</Color>
                    <SolidColorBrush x:Key="AcrylicFlyoutFillColorBrush" Color="{StaticResource AcrylicFlyoutFillColor}" />
                </ResourceDictionary>

                <!-- ================= HIGH CONTRAST =============== -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="AcrylicFlyoutFillColorBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- System Accent Color Brush -->
            <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{ThemeResource SystemAccentColor}" />

            <!-- Geometry Tokens (Windows 11 Fluent 2) -->
            <CornerRadius x:Key="FluentCardCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="FluentControlCornerRadius">4</CornerRadius>
            <x:Double x:Key="FluentCardSpacing">4</x:Double>
            <x:Double x:Key="FluentSectionMaxWidth">1000</x:Double>

            <!-- Section Header Style -->
            <Style x:Key="FluentSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="4,28,0,8" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- Card Style -->
            <Style x:Key="FluentCardStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="{StaticResource FluentCardCornerRadius}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="Padding" Value="16,14" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>

</Application>
