<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AudioDeviceSwitcher.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Audio Device Switcher - Settings">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar (32px) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0" Glyph="&#xE995;" FontSize="14" Margin="16,0,0,0"
                      VerticalAlignment="Center" Foreground="{ThemeResource SystemAccentColorBrush}" />

            <TextBlock Grid.Column="1" Text="Audio Device Switcher" Style="{StaticResource CaptionTextBlockStyle}"
                       Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <!-- Empty Draggable spacer -->
            <Grid Grid.Column="2" x:Name="DragRegionSpacer" Background="Transparent" />

            <!-- Update Available Button (if detected) -->
            <Button x:Name="UpdateBadgeButton" Grid.Column="3" Margin="0,0,140,0" Height="26"
                    Padding="10,0" Visibility="Collapsed" VerticalAlignment="Center"
                    Click="UpdateBadgeButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{ThemeResource SystemAccentColorBrush}" />
                    <TextBlock Text="Update available" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Padding="28,16,28,32">
                <StackPanel MaxWidth="{StaticResource FluentSectionMaxWidth}" HorizontalAlignment="Stretch"
                            Spacing="{StaticResource FluentCardSpacing}">

                    <!-- Page Title -->
                    <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="4,0,0,2" />
                    <TextBlock Text="Configure audio device switching, tray icon behavior, and system appearance."
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0,0,16" />

                    <!-- ================= APPEARANCE SECTION ================= -->
                    <TextBlock Text="Appearance" Style="{StaticResource FluentSectionHeaderStyle}" />

                    <!-- Theme Card -->
                    <Border Style="{StaticResource FluentCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="App theme" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Select Light, Dark, or follow the Windows system setting."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="180" VerticalAlignment="Center"
                                      SelectionChanged="ThemeCombo_SelectionChanged">
                                <ComboBoxItem Content="Use system setting" Tag="System" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Backdrop Material Card -->
                    <Border Style="{StaticResource FluentCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Backdrop material" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Mica blends subtly with your desktop; Mica Alt provides richer contrast."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="BackdropCombo" Grid.Column="1" Width="180" VerticalAlignment="Center"
                                      SelectionChanged="BackdropCombo_SelectionChanged">
                                <ComboBoxItem Content="Mica" Tag="Mica" />
                                <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                                <ComboBoxItem Content="Acrylic (preview)" Tag="Acrylic" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- ================= GENERAL SECTION ================= -->
                    <TextBlock Text="General" Style="{StaticResource FluentSectionHeaderStyle}" />

                    <!-- Launch on Startup Card -->
                    <Border Style="{StaticResource FluentCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Launch on Windows startup" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Automatically start Audio Device Switcher when you sign in (boots minimized in tray)."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" OnContent="" OffContent=""
                                          Toggled="StartupToggle_Toggled" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Start Minimized to Tray Card -->
                    <Border Style="{StaticResource FluentCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Start minimized to system tray" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Start the application directly in the notification area without showing this window."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartMinimizedToggle" Grid.Column="1" OnContent="" OffContent=""
                                          Toggled="StartMinimizedToggle_Toggled" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Global Hotkeys Master Toggle -->
                    <Border Style="{StaticResource FluentCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Global keyboard shortcuts" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Enable system-wide hotkeys to cycle devices or open the volume mixer."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="HotkeysToggle" Grid.Column="1" OnContent="" OffContent=""
                                          Toggled="HotkeysToggle_Toggled" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Quick Switch Hotkey Card -->
                    <Border Style="{StaticResource FluentCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Quick switch shortcut" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Cycle to the next enabled playback device."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="QuickSwitchHotkeyButton" Grid.Column="1" Width="180" Content="Ctrl+Shift+S"
                                    Click="QuickSwitchHotkeyButton_Click" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Open Mixer Hotkey Card -->
                    <Border Style="{StaticResource FluentCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Open volume mixer shortcut" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Summon the flyout mixer above the taskbar."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="OpenMixerHotkeyButton" Grid.Column="1" Width="180" Content="Ctrl+Shift+M"
                                    Click="OpenMixerHotkeyButton_Click" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Tray Scroll Volume Card -->
                    <Border Style="{StaticResource FluentCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Scroll on taskbar icon to change volume" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Hover over the notification tray icon and roll the mouse wheel."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="TrayScrollToggle" Grid.Column="1" OnContent="" OffContent=""
                                          Toggled="TrayScrollToggle_Toggled" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Scroll Volume Step Size Card -->
                    <Border Style="{StaticResource FluentCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Scroll volume step size" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Volume percentage adjusted per mouse wheel tick on the tray icon."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="ScrollStepCombo" Grid.Column="1" Width="180" VerticalAlignment="Center"
                                      SelectionChanged="ScrollStepCombo_SelectionChanged">
                                <ComboBoxItem Content="1% (Fine)" Tag="1" />
                                <ComboBoxItem Content="2% (Default)" Tag="2" />
                                <ComboBoxItem Content="5%" Tag="5" />
                                <ComboBoxItem Content="10% (Fast)" Tag="10" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Volume Overlay Display Duration Card -->
                    <Border Style="{StaticResource FluentCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Volume overlay display duration" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="How long the on-screen volume bar popup stays visible before fading out."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="OsdDurationCombo" Grid.Column="1" Width="180" VerticalAlignment="Center"
                                      SelectionChanged="OsdDurationCombo_SelectionChanged">
                                <ComboBoxItem Content="0.5 seconds (Quick)" Tag="500" />
                                <ComboBoxItem Content="0.8 seconds" Tag="800" />
                                <ComboBoxItem Content="1.0 second" Tag="1000" />
                                <ComboBoxItem Content="1.5 seconds (Default)" Tag="1500" />
                                <ComboBoxItem Content="2.0 seconds" Tag="2000" />
                                <ComboBoxItem Content="3.0 seconds (Long)" Tag="3000" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- ================= AUDIO DEVICES SECTION ================= -->
                    <TextBlock Text="Audio playback devices" Style="{StaticResource FluentSectionHeaderStyle}" />
                    <TextBlock Text="Use the arrow buttons, drag with mouse, or press arrow keys to reorder device cycling. Unplugged devices stay safe and reconnect automatically."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0,0,4" />

                    <!-- Live & Configured Devices List -->
                    <StackPanel x:Name="DevicesContainer" Spacing="{StaticResource FluentCardSpacing}" />

                    <!-- Empty State -->
                    <TextBlock x:Name="NoDevicesTextBlock" Text="No audio playback devices detected."
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed" Margin="8,12" />

                    <!-- ================= ABOUT SECTION ================= -->
                    <TextBlock Text="About" Style="{StaticResource FluentSectionHeaderStyle}" />

                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                        <Expander.Header>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE995;" FontSize="20" VerticalAlignment="Center"
                                          Foreground="{ThemeResource SystemAccentColorBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Audio Device Switcher" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="VersionTextBlock" Text="Version 1.6.2 (WinUI 3 Fluent 2)"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Expander.Header>
                        <Expander.Content>
                            <StackPanel Spacing="10" Padding="0,4,0,4">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                           Text="A modern, high-performance Windows 11 audio switcher and mixer built with WinUI 3 and Windows App SDK. Features instant hotkey device cycling, taskbar volume scroll, acrylic flyouts, and automatic reconnection tolerance for removable earphones and audio endpoints." />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="Check for updates" Click="CheckUpdates_Click" />
                                    <HyperlinkButton Content="GitHub Repository"
                                                     NavigateUri="https://github.com/Kwan-desu/AudioDeviceSwitcher" />
                                </StackPanel>
                            </StackPanel>
                        </Expander.Content>
                    </Expander>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
