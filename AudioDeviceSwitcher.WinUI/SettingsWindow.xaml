<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AudioDeviceSwitcher.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Audio Device Switcher - Settings">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar (36px) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="36" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0" Glyph="&#xE995;" FontSize="14" Margin="16,0,0,0"
                      VerticalAlignment="Center" Foreground="{ThemeResource SystemAccentColorBrush}" />

            <TextBlock Grid.Column="1" Text="Audio Device Switcher" Style="{StaticResource CaptionTextBlockStyle}"
                       Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <!-- Empty Draggable spacer -->
            <Grid Grid.Column="2" x:Name="DragRegionSpacer" Background="Transparent" />

            <!-- Update Available Button (if detected) -->
            <Button x:Name="UpdateBadgeButton" Grid.Column="3" Margin="0,0,144,0" Height="26"
                    Padding="10,0" Visibility="Collapsed" VerticalAlignment="Center"
                    CornerRadius="4"
                    Click="UpdateBadgeButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{ThemeResource SystemAccentColorBrush}" />
                    <TextBlock Text="Update available" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Native Windows 11 Settings NavigationView -->
        <NavigationView x:Name="MainNavView"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="True"
                        PaneDisplayMode="Auto"
                        OpenPaneLength="216"
                        CompactModeThresholdWidth="660"
                        ExpandedModeThresholdWidth="780"
                        SelectionChanged="MainNavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavDevicesItem" Content="Audio devices" Tag="devices" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavMixerItem" Content="Mixer &amp; overlay" Tag="mixer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9E9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavShortcutsItem" Content="Shortcuts &amp; startup" Tag="shortcuts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAppearanceItem" Content="Appearance &amp; about" Tag="appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Main Content Area -->
            <ScrollViewer x:Name="ContentScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid Padding="28,12,28,32">
                    <Grid MaxWidth="{StaticResource FluentSectionMaxWidth}" HorizontalAlignment="Stretch">

                        <!-- ==================== TAB 1: AUDIO DEVICES ==================== -->
                        <StackPanel x:Name="DevicesSectionPanel" Spacing="{StaticResource FluentCardSpacing}" Visibility="Visible">
                            <TextBlock Text="Audio devices" Style="{StaticResource TitleTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="2,0,0,2" />
                            <TextBlock Text="Switch active output, reorder your quick-switch cycle, and customize taskbar badges."
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,14" />

                            <!-- Active Output Hero Card -->
                            <Border Style="{StaticResource FluentCardStyle}" Padding="18,16" Margin="0,0,0,12">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="42" Height="42" CornerRadius="8"
                                                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                                VerticalAlignment="Center">
                                            <FontIcon x:Name="HeroDeviceGlyph" Glyph="&#xE7F6;" FontSize="20"
                                                      Foreground="{ThemeResource SystemAccentColorBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Active output" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <Border x:Name="HeroDeviceBadge"
                                                        Visibility="Collapsed"
                                                        CornerRadius="4"
                                                        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                                        Padding="6,1,6,1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:Name="HeroDeviceBadgeText" Text="AUX 1"
                                                               FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="HeroDeviceNameText" Text="Speakers"
                                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                                       FontSize="16"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button x:Name="HeroQuickSwitchButton"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Click="HeroQuickSwitchButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8AB;" FontSize="13" />
                                                    <TextBlock Text="Quick switch" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="HeroOpenMixerButton"
                                                    ToolTipService.ToolTip="Open Volume Mixer"
                                                    Click="HeroOpenMixerButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE9E9;" FontSize="13" />
                                                    <TextBlock Text="Mixer" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Live Master Volume Control -->
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="HeroMuteButton"
                                                Width="32" Height="32" Padding="0"
                                                Background="Transparent" BorderThickness="0" CornerRadius="4"
                                                ToolTipService.ToolTip="Mute / Unmute"
                                                Click="HeroMuteButton_Click">
                                            <FontIcon x:Name="HeroMuteIcon" Glyph="&#xE995;" FontSize="16"
                                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </Button>

                                        <Slider x:Name="HeroVolumeSlider"
                                                Grid.Column="1"
                                                Minimum="0" Maximum="100"
                                                VerticalAlignment="Center"
                                                ValueChanged="HeroVolumeSlider_ValueChanged" />

                                        <TextBlock x:Name="HeroVolumePercentText"
                                                   Grid.Column="2"
                                                   Text="50%"
                                                   MinWidth="42"
                                                   TextAlignment="Right"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Playback Devices Header -->
                            <TextBlock Text="Configured playback devices" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="2,8,0,2" />
                            <TextBlock Text="Use arrow buttons, drag and drop, or press Up/Down keys to reorder device cycling. Unplugged devices reconnect automatically."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,8" />

                            <!-- Live & Configured Devices List -->
                            <StackPanel x:Name="DevicesContainer" Spacing="{StaticResource FluentCardSpacing}" />

                            <!-- Empty State -->
                            <TextBlock x:Name="NoDevicesTextBlock" Text="No audio playback devices detected."
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed" Margin="8,12" />
                        </StackPanel>

                        <!-- ==================== TAB 2: MIXER & OVERLAY ==================== -->
                        <StackPanel x:Name="MixerSectionPanel" Spacing="{StaticResource FluentCardSpacing}" Visibility="Collapsed">
                            <TextBlock Text="Mixer &amp; overlay" Style="{StaticResource TitleTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="2,0,0,2" />
                            <TextBlock Text="Customize taskbar scroll volume control and the on-screen display overlay."
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,14" />

                            <!-- Tray Scroll Volume Card -->
                            <Border Style="{StaticResource FluentCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE962;" FontSize="18" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Scroll on taskbar icon to change volume" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Hover over the notification tray icon and roll the mouse wheel."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="TrayScrollToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0"
                                                  Toggled="TrayScrollToggle_Toggled" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Scroll Volume Step Size Card -->
                            <Border Style="{StaticResource FluentCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE995;" FontSize="18" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Scroll volume step size" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Volume percentage adjusted per mouse wheel tick on the tray icon and mixer rows."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ScrollStepCombo" Grid.Column="2" Width="180" VerticalAlignment="Center"
                                              SelectionChanged="ScrollStepCombo_SelectionChanged">
                                        <ComboBoxItem Content="1% (Fine)" Tag="1" />
                                        <ComboBoxItem Content="2% (Default)" Tag="2" />
                                        <ComboBoxItem Content="5%" Tag="5" />
                                        <ComboBoxItem Content="10% (Fast)" Tag="10" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Volume Overlay Display Duration Card -->
                            <Border Style="{StaticResource FluentCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE916;" FontSize="18" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Volume overlay display duration" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="How long the on-screen volume bar popup stays visible before fading out."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="OsdDurationCombo" Grid.Column="2" Width="180" VerticalAlignment="Center"
                                              SelectionChanged="OsdDurationCombo_SelectionChanged">
                                        <ComboBoxItem Content="0.5 seconds (Quick)" Tag="500" />
                                        <ComboBoxItem Content="0.8 seconds" Tag="800" />
                                        <ComboBoxItem Content="1.0 second" Tag="1000" />
                                        <ComboBoxItem Content="1.5 seconds (Default)" Tag="1500" />
                                        <ComboBoxItem Content="2.0 seconds" Tag="2000" />
                                        <ComboBoxItem Content="3.0 seconds (Long)" Tag="3000" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Preview OSD Card -->
                            <Border Style="{StaticResource FluentCardStyle}" Margin="0,8,0,0">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="18" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Preview on-screen overlay" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Test how the volume and device switch overlays look on your display."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Volume OSD" Click="PreviewVolumeOsd_Click" />
                                        <Button Content="Switch OSD" Click="PreviewSwitchOsd_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 3: SHORTCUTS & STARTUP ==================== -->
                        <StackPanel x:Name="ShortcutsSectionPanel" Spacing="{StaticResource FluentCardSpacing}" Visibility="Collapsed">
                            <TextBlock Text="Shortcuts &amp; startup" Style="{StaticResource TitleTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="2,0,0,2" />
                            <TextBlock Text="Configure system-wide keyboard shortcuts and Windows startup behavior."
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,14" />

                            <!-- Global Hotkeys Master Toggle -->
                            <Border Style="{StaticResource FluentCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE765;" FontSize="18" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Global keyboard shortcuts" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Enable system-wide hotkeys to cycle devices or open the volume mixer."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="HotkeysToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0"
                                                  Toggled="HotkeysToggle_Toggled" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Quick Switch Hotkey Card -->
                            <Border Style="{StaticResource FluentCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8AB;" FontSize="18" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Quick switch shortcut" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Cycle to the next enabled playback device."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button x:Name="QuickSwitchHotkeyButton" Grid.Column="2" Width="180" Content="Ctrl+Shift+S"
                                            Click="QuickSwitchHotkeyButton_Click" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Open Mixer Hotkey Card -->
                            <Border Style="{StaticResource FluentCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE9E9;" FontSize="18" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Open volume mixer shortcut" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Summon the flyout mixer above the taskbar."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button x:Name="OpenMixerHotkeyButton" Grid.Column="2" Width="180" Content="Ctrl+Shift+M"
                                            Click="OpenMixerHotkeyButton_Click" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <TextBlock Text="Startup" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="2,18,0,6" />

                            <!-- Launch on Startup Card -->
                            <Border Style="{StaticResource FluentCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7E8;" FontSize="18" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Launch on Windows startup" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Automatically start Audio Device Switcher when you sign in (boots minimized in tray)."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="StartupToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0"
                                                  Toggled="StartupToggle_Toggled" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Start Minimized to Tray Card -->
                            <Border Style="{StaticResource FluentCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE73F;" FontSize="18" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Start minimized to system tray" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Start the application directly in the notification area without showing this window."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="StartMinimizedToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0"
                                                  Toggled="StartMinimizedToggle_Toggled" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 4: APPEARANCE & ABOUT ==================== -->
                        <StackPanel x:Name="AppearanceSectionPanel" Spacing="{StaticResource FluentCardSpacing}" Visibility="Collapsed">
                            <TextBlock Text="Appearance &amp; about" Style="{StaticResource TitleTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="2,0,0,2" />
                            <TextBlock Text="Personalize the visual theme, backdrop material, and check for app updates."
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,14" />

                            <!-- Theme Card -->
                            <Border Style="{StaticResource FluentCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="18" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="App theme" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Select Light, Dark, or follow the Windows system setting."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeCombo" Grid.Column="2" Width="180" VerticalAlignment="Center"
                                              SelectionChanged="ThemeCombo_SelectionChanged">
                                        <ComboBoxItem Content="Use system setting" Tag="System" />
                                        <ComboBoxItem Content="Light" Tag="Light" />
                                        <ComboBoxItem Content="Dark" Tag="Dark" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Backdrop Material Card -->
                            <Border Style="{StaticResource FluentCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE81E;" FontSize="18" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Backdrop material" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Mica blends subtly with your desktop; Mica Alt provides richer contrast."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="BackdropCombo" Grid.Column="2" Width="180" VerticalAlignment="Center"
                                              SelectionChanged="BackdropCombo_SelectionChanged">
                                        <ComboBoxItem Content="Mica" Tag="Mica" />
                                        <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                                        <ComboBoxItem Content="Acrylic (preview)" Tag="Acrylic" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="2,18,0,6" />

                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                                <Expander.Header>
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE995;" FontSize="20" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource SystemAccentColorBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Audio Device Switcher" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="VersionTextBlock" Text="Version 1.7.0 (WinUI 3 Fluent 2)"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <Expander.Content>
                                    <StackPanel Spacing="12" Padding="0,4,0,4">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                                   Text="A modern, high-performance Windows 11 audio switcher and mixer built with WinUI 3 and Windows App SDK. Features instant hotkey device cycling, taskbar volume scroll, acrylic flyouts with real-time audio meters, and automatic reconnection tolerance for removable earphones and audio endpoints." />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button Content="Check for updates" Click="CheckUpdates_Click" />
                                            <HyperlinkButton Content="GitHub Repository"
                                                             NavigateUri="https://github.com/Kwan-desu/AudioDeviceSwitcher" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander.Content>
                            </Expander>
                        </StackPanel>

                    </Grid>
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
