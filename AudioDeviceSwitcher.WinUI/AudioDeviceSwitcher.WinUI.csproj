<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AudioDeviceSwitcher</RootNamespace>
    <AssemblyName>AudioDeviceSwitcher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- WinUI 3 desktop app -->
    <UseWinUI>true</UseWinUI>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Unpackaged execution: no MSIX, no package identity, plain .exe -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>

    <!-- Runtime identifiers this project can be published for -->
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <Platforms>x64;x86;ARM64</Platforms>

    <EnablePreviewMsbuildFeatures>false</EnablePreviewMsbuildFeatures>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>

    <Version>1.6.0</Version>
    <AssemblyVersion>1.6.0.0</AssemblyVersion>
    <FileVersion>1.6.0.0</FileVersion>

    <!-- Suppress .NET Framework compatibility warning for AudioSwitcher package -->
    <NoWarn>$(NoWarn);NU1701;NU1900</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('app.ico')">
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="AudioSwitcher.AudioApi.CoreAudio" Version="3.0.3" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <Target Name="EnsureResourcesPri" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)AudioDeviceSwitcher.pri" DestinationFiles="$(TargetDir)resources.pri" Condition="Exists('$(TargetDir)AudioDeviceSwitcher.pri')" />
  </Target>

  <Target Name="CopyPriAndXbfToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)AudioDeviceSwitcher.pri" DestinationFiles="$(PublishDir)resources.pri" Condition="Exists('$(TargetDir)AudioDeviceSwitcher.pri')" />
    <ItemGroup>
      <XbfFiles Include="$(TargetDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(XbfFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
