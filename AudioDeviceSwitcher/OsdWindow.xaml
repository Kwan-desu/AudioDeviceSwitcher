<Window x:Class="AudioDeviceSwitcher.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OSD" Height="80" Width="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="False"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <Border CornerRadius="8" Background="#CC101010" BorderBrush="#25FFFFFF" BorderThickness="1">
        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Speaker Icon placeholder -->
            <TextBlock Text="🔊" FontSize="24" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0"/>
            
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Audio Device Switched" Foreground="#A0A0A0" FontSize="12"/>
                <TextBlock x:Name="DeviceNameText" Text="Headphones" Foreground="White" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
